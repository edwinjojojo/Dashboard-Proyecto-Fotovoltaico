# Copy to .env for local overrides (never commit .env).
# Client-visible (bundled into the browser build):
# Leave empty for GitHub Pages / same-origin static files (uses Vite `base`).
VITE_DATA_BASE=

# Optional: use the mock API path served by Vite (same JSON files on disk):
# VITE_DATA_BASE=/api/data
# On Pages, prefer empty VITE_DATA_BASE so fetches use /Dashboard-Proyecto-Fotovoltaico/…

# Preview gate only (scripts/preview-auth.mjs) — demo credentials, not production secrets:
BASIC_AUTH_USER=demo
BASIC_AUTH_PASS=piloto
PREVIEW_AUTH_PORT=4174
